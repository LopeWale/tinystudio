{
  "name": "tinystudio-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{js,ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.json\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.json\" \"*.ts\""
  },
  "dependencies": {
    "@remixicon/react": "4.9.0",
    "@tailwindcss/postcss": "4.3.3",
    "@xyflow/react": "12.12.0",
    "echarts": "6.1.0",
    "plotly.js-gl3d-dist-min": "4.1.2",
    "react": "19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "visual-truth": "file:vendor/visual-truth/visual-truth-1.3.0.tgz",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
