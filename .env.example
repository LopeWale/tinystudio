# tinystudio configuration. Copy to .env (next to this file or in the directory you run tinystudio from);
# every value here is optional and can also be exported in the shell. Existing environment variables win.

# --- project and server
# TINYSTUDIO_PROJECT=/absolute/path/to/your/project      # default project for the CLI (--project overrides)
# TINYSTUDIO_HOST=127.0.0.1                              # bind address for `tinystudio serve` (0.0.0.0 to reach it from other machines)
# TINYSTUDIO_PORT=8000

# --- compute
# TINYSTUDIO_DEVICE=auto        # auto | cuda | cuda:1 | mps | cpu   (auto: CUDA, then Apple MPS, then CPU)
# TINYSTUDIO_DTYPE=auto         # auto | fp32 | bf16 | fp16          (auto: bf16 on CUDA GPUs that support it, fp32 on MPS and CPU)
# PYTORCH_ENABLE_MPS_FALLBACK=1 # Apple GPUs: run unsupported ops on the CPU instead of failing
# TOKENIZERS_PARALLELISM=false

# --- helper LLM (synthetic data, labelling, rubric judging, neuron explanations): any OpenAI-compatible server
# TINYSTUDIO_LLM_BASE_URL=http://127.0.0.1:8080/v1       # mlx_lm.server, llama-server, Ollama, vLLM, or a hosted API
# TINYSTUDIO_LLM_MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit   # required when the server lists more than one model
# TINYSTUDIO_LLM_API_KEY=                                 # only for hosted servers that need a bearer token

# --- embeddings for repositories (RAG): any Hugging Face feature-extraction model
# TINYSTUDIO_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- in-app assistant (floating ✦ button) and the Assistant page
# ANTHROPIC_API_KEY=sk-ant-...          # or run `ant auth login`; any Claude model your account lists is selectable
# TINYSTUDIO_ANTHROPIC_WORKSPACE_ID=wrkspc_...  # only for organization-level keys (ID column on https://platform.claude.com/settings/workspaces); keys created inside a workspace need nothing
# TINYSTUDIO_ANTHROPIC_MODEL=claude-opus-5-5
# TINYSTUDIO_ASSISTANT_EFFORT=medium    # low | medium | high
# OPENAI_API_KEY=sk-...                 # any OpenAI chat model your account lists is selectable
# TINYSTUDIO_OPENAI_MODEL=              # default OpenAI model id (optional; pick one in the widget)

# --- Hugging Face Hub (gated models, uploads)
# HF_TOKEN=hf_...                       # or `tinystudio hub login hf_...`
