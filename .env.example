# tinystudio deployment configuration. Copy to .env (next to this file or in the directory you run from).
# Team settings (helper LLM, embedding model, Claude/OpenAI keys, Hugging Face token) live in the Settings page,
# stored in PostgreSQL; values here only seed them. Nothing below is needed when you use docker compose defaults.

# --- stores (docker compose wires these for the containers; set them for processes running outside) ---
# TINYSTUDIO_DATABASE_URL=postgresql+psycopg://tinystudio:tinystudio@127.0.0.1:5432/tinystudio
# TINYSTUDIO_REDIS_URL=redis://127.0.0.1:6379/0
# TINYSTUDIO_QDRANT_URL=http://127.0.0.1:6333
# TINYSTUDIO_QDRANT_API_KEY=
# TINYSTUDIO_DATA_DIR=~/.tinystudio/data          # persistent directory for local backend only; ignored in R2 mode
# TINYSTUDIO_CACHE_DIR=/tmp/tinystudio-cache     # optional disposable R2 runtime workspace; defaults to namespaced OS temp
# --- compose: every port, bind address, and credential the stack uses (one variable each, used for the
#     container's listen port, the published host port, and the URLs handed to the app) ---
# POSTGRES_USER=tinystudio
# POSTGRES_PASSWORD=tinystudio
# POSTGRES_DB=tinystudio
# POSTGRES_PORT=5432
# POSTGRES_BIND=127.0.0.1
# POSTGRES_IMAGE=postgres:18-alpine
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_BIND=127.0.0.1
# REDIS_IMAGE=redis:8-alpine
# QDRANT_PORT=6333
# QDRANT_GRPC_PORT=6334
# QDRANT_BIND=127.0.0.1
# QDRANT_API_KEY=
# QDRANT_IMAGE=qdrant/qdrant:v1.20.0

# --- processes ---
# TINYSTUDIO_HOST=127.0.0.1                        # API bind address (0.0.0.0 to reach it from other machines; compose sets it)
# TINYSTUDIO_PORT=8000                             # API port, native and in compose (listen port and published port)
# TINYSTUDIO_BIND=0.0.0.0                          # compose: host interface for the API port
# TINYSTUDIO_INFERENCE_HOST=0.0.0.0                # inference service bind address
# TINYSTUDIO_INFERENCE_PORT=8001                   # inference service port, native and in compose
# TINYSTUDIO_INFERENCE_URL=http://inference:8001   # API -> inference service; unset = models load inside the API process (compose composes it from the port)
# TINYSTUDIO_SELF_URL=http://127.0.0.1:8000        # how the API reaches itself (the assistant calls back over HTTP)
# TINYSTUDIO_SECURE_COOKIES=1                      # set behind HTTPS
# TINYSTUDIO_SESSION_DAYS=14
# TINYSTUDIO_SYNC_ROW_LIMIT=100000                # cleaning, autosplit and snapshots on larger datasets run as worker tasks (Cloudflare's proxy read timeout is 125 s)

# --- first start ---
# TINYSTUDIO_ADMIN_EMAIL=you@example.com           # creates the first admin when the users table is empty
# TINYSTUDIO_ADMIN_PASSWORD=change-me              # (or use the setup form on first visit / `tinystudio users create --admin`)

# --- compute (per host: a GPU box runs the worker and inference, a laptop runs the API) ---
# TINYSTUDIO_DEVICE=auto                           # auto, cuda, cuda:1, mps, cpu
# TINYSTUDIO_DTYPE=auto                            # auto (bf16 on CUDA, fp32 elsewhere), fp32, bf16, fp16
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128   # compose build: the PyTorch wheel index for the image
# PYTORCH_ENABLE_MPS_FALLBACK=1

# --- laboratory A/B delivery ---
# The API owns its laboratory dispatcher process. Run `tinystudio worker` separately for evidence operations.
# Optional: enable experiment delivery for the enrolled RQ target on both API/dispatcher and worker hosts.
# TINYSTUDIO_LAB_RQ_CREDENTIAL_FILE=/absolute/path/runner-rq.json
# The file must be owned, regular, nonsymlink and mode 0600; it contains server, target_id, token,
# optional profile_config (rq supports trusted_native only), and optional access{client_id,client_secret,public_url}.
# RQ carries IDs only; its worker still needs the normal PostgreSQL/Redis deployment settings above.
# A separate outbound `tinystudio runner --credential-file runner.json` needs only scoped HTTP credentials,
# not database, Redis or object-store credentials. See docs/laboratory.md for recovery and operation IDs.

# --- seeds for the Settings page (stored values win) ---
# TINYSTUDIO_LLM_BASE_URL=http://127.0.0.1:8080/v1
# TINYSTUDIO_LLM_MODEL=
# TINYSTUDIO_LLM_API_KEY=
# TINYSTUDIO_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# ANTHROPIC_API_KEY=sk-ant-...
# TINYSTUDIO_ANTHROPIC_WORKSPACE_ID=wrkspc_...     # only for organization-level keys (ID column on https://platform.claude.com/settings/workspaces)
# TINYSTUDIO_ANTHROPIC_MODEL=claude-opus-5-5
# TINYSTUDIO_ASSISTANT_EFFORT=medium
# OPENAI_API_KEY=sk-...
# TINYSTUDIO_OPENAI_MODEL=
# HF_TOKEN=hf_...

# --- MCP clients (claude mcp add / Claude Desktop / Codex run `tinystudio mcp`) ---
# TINYSTUDIO_URL=http://127.0.0.1:8000
# TINYSTUDIO_PROJECT=my-project                    # project slug
# TINYSTUDIO_API_KEY=ts-...                        # from the API Keys page

# Cloudflare artifact storage. Set r2 for durable files shared across hosts.
# Each host uses its own disposable cache and the same database/queue/vector endpoints.
TINYSTUDIO_STORAGE_BACKEND=local
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
TINYSTUDIO_PUBLIC_URL=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
TINYSTUDIO_CF_ACCESS_REQUIRED=0
# External Studio/MCP/SDK and laboratory runner clients; never embed these in browser JavaScript.
# Access headers are sent only to the matching approved HTTPS TINYSTUDIO_PUBLIC_URL origin.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Connector only. scripts/services.py loads it without writing it into a plist.
TUNNEL_TOKEN=
